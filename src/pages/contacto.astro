<script>
  const form = document.getElementById('quotation-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const labels = {
        nombre: 'Nombre',
        empresa: 'Empresa',
        cargo: 'Cargo',
        celular: 'Celular',
        correo: 'Correo',
        ciudad: 'Ciudad',
        producto: 'Producto de interés',
        cantidad: 'Cantidad aproximada',
        personalizacion: 'Personalización',
        mensaje: 'Mensaje',
      };
      const lines = ['Hola, buen día 👋 Vengo desde su página web fairscompany.com y quisiera solicitar una cotización con los siguientes datos:', ''];
      for (const [key, label] of Object.entries(labels)) {
        const value = (data.get(key) || '').toString().trim();
        if (value) lines.push(`${label}: ${value}`);
      }
      const url = `https://wa.me/51934336181?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>

