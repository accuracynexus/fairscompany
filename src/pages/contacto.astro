---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import HeaderPattern from '../components/HeaderPattern.astro';
import contactoImg from '../img/secciones/contacto.jpg';

const faqs = [
  {
    q: '¿Cuál es el pedido mínimo?',
    a: 'El pedido mínimo es de 24 unidades. Puede variar según el tipo de prenda y el nivel de personalización requerido.',
  },
  {
    q: '¿Realizan diseños personalizados?',
    a: 'Sí. Todos nuestros productos pueden adaptarse a la identidad gráfica y necesidades del cliente.',
  },
  {
    q: '¿Cuánto demora la producción?',
    a: 'El tiempo de entrega depende del tipo de prenda y del volumen del pedido. Lo confirmamos al momento de la cotización.',
  },
  {
    q: '¿Realizan envíos a provincias?',
    a: 'Sí. Atendemos pedidos y realizamos envíos a nivel nacional.',
  },
  {
    q: '¿Qué materiales utilizan?',
    a: 'Trabajamos con materiales de alta calidad seleccionados según el tipo de prenda y su uso.',
  },
  {
    q: '¿Cómo puedo solicitar una cotización?',
    a: 'Puede contactarnos mediante WhatsApp, el formulario web o correo electrónico.',
  },
];

const coverageCities = [
  'Lima', 'Huancayo', 'Arequipa', 'Cusco', 'Trujillo', 'Piura', 'Chiclayo',
  'Huánuco', 'Ayacucho', 'Junín', 'Ica', 'Tacna', 'Puno',
];
---

<Layout
  title="Contacto"
  description="Contáctanos para cotizar uniformes y prendas personalizadas. WhatsApp, formulario web o correo. Fábrica en La Molina, Lima, con envíos a todo el Perú. Pedido mínimo 24 unidades."
>
  <!-- Section Title Header -->
  <div class="page-header scroll-animate">
    <HeaderPattern />
    <div class="container">
      <h1>CONTACTANOS</h1>
      <p>Comunícate con nosotros para solicitar tu cotización o resolver tus dudas.</p>
    </div>
  </div>

  <section class="section container">
    <div class="contact-layout-grid">
      
      <!-- Left Column -->
      <div class="contact-left-col scroll-animate">
        <div class="need-garments-box">
          <h2><span class="orange-arrow">&rarr;</span> ¿Necesitas prendas personalizadas?</h2>
          <p>
            En FAIR'S COMPANY estamos listos para asesorarte en la confección de prendas personalizadas para empresas, colegios, instituciones y el sector salud. Completa el formulario o comunícate con nosotros por cualquiera de nuestros canales. Será un gusto atenderte.
          </p>
        </div>
        
        <div class="meeting-image-wrapper">
          <img src={contactoImg.src} alt="Reunión en Taller de Confección Fair's Company" />
        </div>
      </div>
      
      <!-- Right Column -->
      <div class="contact-right-col">
        <!-- Formulario de Cotización -->
        <div class="quotation-form-box scroll-animate animate-delay-1">
          <h3>Formulario de cotización</h3>

          <form id="quotation-form" class="quotation-form">
            <div class="form-row-2">
              <div class="form-group-wix">
                <label for="q-nombre">Nombre *</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <input type="text" id="q-nombre" name="nombre" placeholder="Tu nombre completo" required />
                </div>
              </div>
              <div class="form-group-wix">
                <label for="q-empresa">Empresa</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/></svg>
                  <input type="text" id="q-empresa" name="empresa" placeholder="Nombre de tu empresa o institución" />
                </div>
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group-wix">
                <label for="q-cargo">Cargo</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  <input type="text" id="q-cargo" name="cargo" placeholder="Ej. Jefe de Logística" />
                </div>
              </div>
              <div class="form-group-wix phone-input-wix">
                <label for="q-celular">Celular *</label>
                <div class="input-wrap">
                  <img class="field-flag" src="/flags/pe.svg" alt="Perú" width="22" height="15" />
                  <span class="phone-prefix">+51</span>
                  <input type="tel" id="q-celular" name="celular" placeholder="999 999 999" required />
                </div>
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group-wix">
                <label for="q-correo">Correo Electrónico</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  <input type="email" id="q-correo" name="correo" placeholder="tucorreo@empresa.com" />
                </div>
              </div>
              <div class="form-group-wix">
                <label for="q-ciudad">Ciudad</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <input type="text" id="q-ciudad" name="ciudad" placeholder="Ej. Lima" />
                </div>
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group-wix">
                <label for="q-producto">Producto de Interés</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                  <select id="q-producto" name="producto">
                  <option value="">Selecciona una opción</option>
                  <option>Uniformes escolares</option>
                  <option>Prendas de promoción</option>
                  <option>Uniformes corporativos</option>
                  <option>Uniformes médicos</option>
                  <option>Uniformes industriales (minería y construcción)</option>
                  <option>Indumentaria para hotelería</option>
                  <option>Indumentaria para gastronomía</option>
                  <option>Merchandising corporativo</option>
                  <option>Otro</option>
                  </select>
                </div>
              </div>
              <div class="form-group-wix">
                <label for="q-cantidad">Cantidad Aproximada</label>
                <div class="input-wrap">
                  <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                  <input type="number" id="q-cantidad" name="cantidad" min="1" placeholder="Ej. 50 unidades" />
                </div>
              </div>
            </div>

            <div class="form-group-wix">
              <label for="q-personalizacion">Personalización</label>
              <div class="input-wrap">
                <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/></svg>
                <select id="q-personalizacion" name="personalizacion">
                <option value="">Selecciona una opción</option>
                <option>Bordado</option>
                <option>Estampado</option>
                <option>Sublimado</option>
                <option>Serigrafía</option>
                <option>DTF / Vinil textil</option>
                <option>Varias técnicas</option>
                <option>Por definir</option>
                </select>
              </div>
            </div>

            <div class="form-group-wix">
              <label for="q-mensaje">Mensaje</label>
              <div class="input-wrap input-wrap--textarea">
                <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <textarea id="q-mensaje" name="mensaje" rows="4" placeholder="Cuéntanos los detalles de tu pedido: tallas, colores, fecha estimada…"></textarea>
              </div>
            </div>

            <button type="submit" class="btn-submit-wix">Solicitar Cotización</button>
            <p id="q-note" class="form-note">Al enviar, abriremos WhatsApp con tu solicitud lista para mandar.</p>
          </form>
        </div>
      </div>
    </div>

    <!-- Información de Contacto Directo: fila completa a todo el ancho -->
    <div class="contact-details-box scroll-animate animate-delay-2">
      <div class="details-main">
        <h4>INFORMACIÓN DE CONTACTO</h4>
        <ul class="contact-info-list">
            <li>
              <span class="ci-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="ci-text">
                <span class="ci-label">Sede Lima</span>
                <span class="ci-value">Los Aperos 150 La Molina, Lima, Perú</span>
              </span>
            </li>
            <li>
              <span class="ci-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="ci-text">
                <span class="ci-label">Sucursal Huancayo</span>
                <span class="ci-value">Jr. Moquegua 1061 Huancayo</span>
              </span>
            </li>
            <li>
              <span class="ci-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              </span>
              <span class="ci-text">
                <span class="ci-label">Teléfono</span>
                <a class="ci-value" href="tel:+51934336181">+51 934 336 181</a>
              </span>
            </li>
            <li>
              <span class="ci-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <span class="ci-text">
                <span class="ci-label">Correo</span>
                <a class="ci-value" href="mailto:ventas@fairscompany.com">ventas@fairscompany.com</a>
              </span>
            </li>
            <li>
              <span class="ci-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <span class="ci-text">
                <span class="ci-label">Horario</span>
                <span class="ci-value">Lunes a viernes · 9:30 a.m. &ndash; 6:00 p.m.<br />Sábados · 9:30 a.m. &ndash; 1:00 p.m.</span>
              </span>
            </li>
        </ul>
      </div>

      <div class="details-aside">
        <h4 class="title-grey">ATENCIÓN INMEDIATA</h4>
        <p class="immediate-desc">
          Escríbenos directamente por WhatsApp y uno de nuestros asesores te atenderá.
        </p>

        <a href={`https://wa.me/51934336181?text=${encodeURIComponent('Hola, buen día 👋 Vengo desde su página web fairscompany.com y quisiera solicitar una cotización de prendas personalizadas. ¿Me podrían orientar?')}`} target="_blank" rel="noopener noreferrer" class="btn-whatsapp-wix">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-23.1-115-65-157zM223.9 414.7c-33.1 0-65.5-8.9-94-25.7l-6.7-4-69.8 18.3L72 334.1l-4.4-7.1c-18.4-29.6-28.1-64-28.1-99.1 0-103.5 84.3-187.8 187.9-187.8 50.2 0 97.4 19.5 132.9 55.1 35.5 35.6 55.1 82.7 55.1 133 0 103.6-84.3 187.8-187.9 187.8zM326.6 280c-5.6-2.8-33.3-16.4-38.5-18.3-5.2-1.9-9-2.8-12.8 2.8-3.7 5.6-14.6 18.3-17.9 22.1-3.3 3.8-6.6 4.2-12.2 1.4-5.6-2.8-23.7-8.8-45.2-28.1-16.7-15-28-33.5-31.3-39.1-3.3-5.6-.3-8.6 2.5-11.4 2.5-2.5 5.6-6.6 8.5-9.9 2.8-3.3 3.8-5.6 5.6-9.4 1.9-3.7.9-7.1-.5-9.9-1.4-2.8-12.8-30.9-17.5-42.3-4.6-11.2-9.3-9.7-12.8-9.9-3.3-.2-7.1-.2-10.8-.2-3.7 0-9.9 1.4-15.1 7.1-5.2 5.6-19.8 19.3-19.8 47s20.2 54.4 23 58.2c2.8 3.8 39.7 60.6 96.1 85 13.4 5.8 23.9 9.3 32.1 11.9 13.5 4.3 25.8 3.7 35.5 2.2 10.9-1.7 33.3-13.6 38-26.8 4.6-13.2 4.6-24.4 3.3-26.8-1.4-2.4-5.2-3.8-10.8-6.6z"/></svg>
          CONTACTAR POR WHATSAPP
        </a>

        <h4 class="title-grey social-title">SÍGUENOS</h4>
        <div class="social-row">
            <a href="https://www.facebook.com/share/1Gpv3S2KNE/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
            </a>
            <a href="https://www.instagram.com/fairs.company?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://www.tiktok.com/@fairstyle6?_r=1&_t=ZS-98OpHvaFnvR" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.12v-3.16a5.73 5.73 0 0 0-.77-.05 5.75 5.75 0 1 0 5.75 5.75V9.01a7.35 7.35 0 0 0 4.31 1.38V7.3a4.28 4.28 0 0 1-3.32-1.48Z"/></svg>
            </a>
            <a href="https://wa.me/51934336181" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="WhatsApp Business">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-23.1-115-65-157zM223.9 414.7c-33.1 0-65.5-8.9-94-25.7l-6.7-4-69.8 18.3L72 334.1l-4.4-7.1c-18.4-29.6-28.1-64-28.1-99.1 0-103.5 84.3-187.8 187.9-187.8 50.2 0 97.4 19.5 132.9 55.1 35.5 35.6 55.1 82.7 55.1 133 0 103.6-84.3 187.8-187.9 187.8zM326.6 280c-5.6-2.8-33.3-16.4-38.5-18.3-5.2-1.9-9-2.8-12.8 2.8-3.7 5.6-14.6 18.3-17.9 22.1-3.3 3.8-6.6 4.2-12.2 1.4-5.6-2.8-23.7-8.8-45.2-28.1-16.7-15-28-33.5-31.3-39.1-3.3-5.6-.3-8.6 2.5-11.4 2.5-2.5 5.6-6.6 8.5-9.9 2.8-3.3 3.8-5.6 5.6-9.4 1.9-3.7.9-7.1-.5-9.9-1.4-2.8-12.8-30.9-17.5-42.3-4.6-11.2-9.3-9.7-12.8-9.9-3.3-.2-7.1-.2-10.8-.2-3.7 0-9.9 1.4-15.1 7.1-5.2 5.6-19.8 19.3-19.8 47s20.2 54.4 23 58.2c2.8 3.8 39.7 60.6 96.1 85 13.4 5.8 23.9 9.3 32.1 11.9 13.5 4.3 25.8 3.7 35.5 2.2 10.9-1.7 33.3-13.6 38-26.8 4.6-13.2 4.6-24.4 3.3-26.8-1.4-2.4-5.2-3.8-10.8-6.6z"/></svg>
            </a>
          </div>
      </div>
    </div>
  </section>

  <!-- Google Maps Embed Section -->
  <section class="map-section scroll-animate">
    <div class="container" style="max-width: 1100px;">
      <div class="text-center" style="margin-bottom: 2.5rem;">
        <h3 class="map-section-title">Nuestras Ubicaciones</h3>
        <p style="color: #666;">Atiéndete en nuestra sede de Lima o en nuestra sucursal de Huancayo.</p>
      </div>

      <div class="maps-grid">
        <article class="map-card">
          <div class="map-card-frame">
            <div class="map-wrapper-wix">
              <iframe
                title="Mapa de la sede de Lima: Los Aperos 150 La Molina"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.691763785465!2d-76.9405626248386!3d-12.064731188173516!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c6ecfa20a6c7%3A0x6b30f80e7ad4492!2sLos%20Aperos%20150%2C%20La%20Molina!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe"
                width="100%"
                height="340"
                style="border:0; display: block;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
          </div>
          <div class="map-card-body">
            <span class="map-card-label">Sede Lima</span>
