---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getActiveProducts, resolveProductImage, getCategoryImages } from '../db/client';
import { categories } from '../lib/categories';

export const prerender = false;

const WHATSAPP_NUMBER = '51964525381';
const products = getActiveProducts();

// Category image = admin override (if any) → default seeded photo → icon.
const categoryOverrides = getCategoryImages();
const categoryImage = (cat: (typeof categories)[number]) =>
  categoryOverrides[cat.key] ?? resolveProductImage(cat.imageSeed);

---

<Layout
  title="Productos"
  description="Catálogo de uniformes y prendas personalizadas: escolares, de promoción, corporativos, médicos, industriales/EPP, hotelería, gastronomía y merchandising. Diseño, bordado y estampado a medida en todo el Perú."
>
  <div class="page-header scroll-animate">
    <div class="container">
      <h1>Nuestros Productos</h1>
      <p>Explora nuestra línea de prendas personalizadas para empresas, colegios e instituciones.</p>
    </div>
  </div>

  <!-- Categorías: qué confecciona Fair's Company -->
  <section class="section container categories-section">
    <div class="cat-intro text-center">
      <h2 class="section-title scroll-animate">Lo que confeccionamos</h2>
      <p class="section-subtitle scroll-animate animate-delay-1">
        Desarrollamos soluciones textiles a medida para cada sector. Explora cada categoría para ver los productos,
        materiales, tallas y opciones de personalización disponibles.
      </p>
    </div>

    <div class="cat-accordion">
      {categories.map((cat, i) => (
        <details class={`cat-card scroll-animate animate-delay-${(i % 3) + 1}`}>
          <summary class="cat-summary">
            <span class="cat-media">
              {categoryImage(cat) ? (
                <img src={categoryImage(cat)} alt={cat.name} loading="lazy" />
              ) : (
                <span class="cat-media-ph">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
                </span>
              )}
            </span>
            <span class="cat-head">
              <span class="cat-tag">
                <svg class="cat-tag-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
                {cat.tag}
              </span>
              <span class="cat-name">{cat.name}</span>
              <span class="cat-desc">{cat.description}</span>
            </span>
            <span class="cat-chevron" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>

          <div class="cat-detail">
            <div class="cat-block">
              <h4 class="cat-block-title">Productos</h4>
              <ul class="chip-list">
                {cat.productos.map((p) => <li>{p}</li>)}
              </ul>
            </div>

            <div class="cat-detail-grid">
              <div class="cat-block">
                <h4 class="cat-block-title">Personalización</h4>
                <ul class="chip-list chip-list--accent">
                  {cat.personalizacion.map((p) => <li>{p}</li>)}
                </ul>
              </div>

              <dl class="cat-meta">
                <div class="cat-meta-row">
                  <dt>Material</dt>
                  <dd>{cat.material}</dd>
                </div>
                <div class="cat-meta-row">
                  <dt>Colores</dt>
                  <dd>{cat.colores}</dd>
                </div>
                <div class="cat-meta-row">
                  <dt>Tallas</dt>
                  <dd>{cat.tallas}</dd>
                </div>
              </dl>
            </div>

            <a
              class="cat-quote-btn"
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hola, buen día 👋 Vengo desde su página web fairscompany.com y quisiera cotizar la línea de ${cat.name}. ¿Me podrían ayudar?`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="cat-wa-icon">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-23.1-115-65-157zM223.9 414.7c-33.1 0-65.5-8.9-94-25.7l-6.7-4-69.8 18.3L72 334.1l-4.4-7.1c-18.4-29.6-28.1-64-28.1-99.1 0-103.5 84.3-187.8 187.9-187.8 50.2 0 97.4 19.5 132.9 55.1 35.5 35.6 55.1 82.7 55.1 133 0 103.6-84.3 187.8-187.9 187.8zM326.6 280c-5.6-2.8-33.3-16.4-38.5-18.3-5.2-1.9-9-2.8-12.8 2.8-3.7 5.6-14.6 18.3-17.9 22.1-3.3 3.8-6.6 4.2-12.2 1.4-5.6-2.8-23.7-8.8-45.2-28.1-16.7-15-28-33.5-31.3-39.1-3.3-5.6-.3-8.6 2.5-11.4 2.5-2.5 5.6-6.6 8.5-9.9 2.8-3.3 3.8-5.6 5.6-9.4 1.9-3.7.9-7.1-.5-9.9-1.4-2.8-12.8-30.9-17.5-42.3-4.6-11.2-9.3-9.7-12.8-9.9-3.3-.2-7.1-.2-10.8-.2-3.7 0-9.9 1.4-15.1 7.1-5.2 5.6-19.8 19.3-19.8 47s20.2 54.4 23 58.2c2.8 3.8 39.7 60.6 96.1 85 13.4 5.8 23.9 9.3 32.1 11.9 13.5 4.3 25.8 3.7 35.5 2.2 10.9-1.7 33.3-13.6 38-26.8 4.6-13.2 4.6-24.4 3.3-26.8-1.4-2.4-5.2-3.8-10.8-6.6z"/>
              </svg>
              Cotizar esta línea por WhatsApp
            </a>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Galería de trabajos confeccionados -->
  <section class="section container gallery-section">
    <div class="text-center">
      <h2 class="section-title scroll-animate">Galería de trabajos</h2>
      <p class="section-subtitle scroll-animate animate-delay-1">
        Algunas prendas que hemos confeccionado. Haz clic en cualquiera para una vista rápida y cotización.
      </p>
    </div>

    <div class="products-grid">
      {products.map((product, index) => (
        <ProductCard
          name={product.name}
          category={product.category}
          image={resolveProductImage(product.image_url)}
          animateClass={`scroll-animate animate-delay-${(index % 3) + 1}`}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .text-center { text-align: center; }

  .section-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    max-width: 760px;
    margin: 0 auto 3.5rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: #555;
  }

  /* Categories accordion */
  .categories-section { padding-top: 2rem; }

  .cat-accordion {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .cat-card {
    border: 1px solid #ece7e3;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 6px 20px rgba(30, 24, 20, 0.05);
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .cat-card:hover { box-shadow: 0 12px 32px rgba(30, 24, 20, 0.1); }
  .cat-card[open] { border-color: rgba(234, 88, 35, 0.4); }

  .cat-summary {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }
  .cat-summary::-webkit-details-marker { display: none; }

  .cat-media {
    flex-shrink: 0;
    width: 118px;
    height: 118px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-tint);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cat-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat-media-ph {
    width: 46px;
    height: 46px;
    color: var(--color-accent);
    opacity: 0.85;
  }
  .cat-media-ph svg { width: 100%; height: 100%; }

  .cat-head {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    background: rgba(234, 88, 35, 0.1);
    padding: 0.3rem 0.7rem;
    border-radius: 20px;
  }
  .cat-tag-icon { width: 13px; height: 13px; }
  .cat-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
  }
  .cat-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #777;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cat-card[open] .cat-desc {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .cat-chevron {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f6f2ef;
    color: var(--color-accent);
    transition: transform 0.3s ease, background 0.2s ease;
  }
  .cat-chevron svg { width: 18px; height: 18px; }
  .cat-card[open] .cat-chevron { transform: rotate(180deg); }

  /* Expanded detail */
  .cat-detail {
    padding: 0.5rem 1.4rem 1.6rem;
    border-top: 1px solid #f0ebe7;
    margin-top: -0.2rem;
  }
  .cat-detail > .cat-block:first-child { margin-top: 1.2rem; }

  .cat-block-title {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-text);
    margin-bottom: 0.8rem;
  }

  .chip-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }
  .chip-list li {
    font-size: 0.86rem;
    color: #444;
    background: #f4f1ef;
    border: 1px solid #ece7e3;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
  }
  .chip-list--accent li {
    color: var(--color-accent);
    background: rgba(234, 88, 35, 0.08);
    border-color: rgba(234, 88, 35, 0.2);
  }

  .cat-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
  }

  .cat-meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .cat-meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .cat-meta-row dt {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
  }
  .cat-meta-row dd {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #555;
  }

  .cat-quote-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
    padding: 0.8rem 1.5rem;
    background: var(--color-whatsapp);
    color: #fff;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.3px;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.22);
  }
  .cat-quote-btn:hover {
    background: #1fb956;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(37, 211, 102, 0.32);
  }
  .cat-wa-icon { width: 18px; height: 18px; }

  /* Gallery */
  .gallery-section { padding-top: 4rem; }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .section-title { font-size: 2.1rem; }
    .section-subtitle { font-size: 1rem; margin-bottom: 2.5rem; }

    .cat-summary { gap: 1rem; padding: 1rem; }
    .cat-media { width: 84px; height: 84px; }
    .cat-media-ph { width: 34px; height: 34px; }
    .cat-name { font-size: 1.05rem; }
    .cat-desc { -webkit-line-clamp: 3; }
    .cat-detail-grid { grid-template-columns: 1fr; gap: 1.6rem; }

    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 560px) {
    .cat-summary { flex-wrap: wrap; }
    .cat-media { width: 60px; height: 60px; border-radius: 10px; }
    .cat-media-ph { width: 26px; height: 26px; }
    .cat-chevron { width: 30px; height: 30px; }
    .cat-head { flex-basis: calc(100% - 60px - 34px - 2rem); }
  }

  @media (max-width: 480px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
