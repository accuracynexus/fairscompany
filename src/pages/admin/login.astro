---
import { getImage } from 'astro:assets';
import '../../styles/global.css';
import brandMark from '../../img/logo/logo-splash.png';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
const favicon = await getImage({ src: brandMark, width: 256, format: 'png' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>Iniciar sesión | Fair's Company Admin</title>
  </head>
  <body>
    <main class="login-page">
      <form class="login-card" method="POST" action="/api/admin/login">
        <h1>FAIR'S COMPANY</h1>
        <p class="subtitle">Panel de administración</p>

        {error && <p class="login-error">Usuario o contraseña incorrectos.</p>}

        <label>
          Usuario
          <input type="text" name="user" autocomplete="username" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" autocomplete="current-password" required />
        </label>

        <button type="submit" class="btn btn-primary">Ingresar</button>
      </form>
    </main>
  </body>
</html>

<style>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-dark);
    padding: 2rem;
  }
  .login-card {
    background: #ffffff;
    padding: 3rem 2.5rem;
    border-radius: 10px;
    width: 100%;
    max-width: 380px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    text-align: center;
  }
  .login-card h1 {
    font-size: 1.4rem;
    letter-spacing: 3px;
    margin-bottom: 0.3rem;
  }
  .subtitle {
    color: #888;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }
  .login-error {
    background: #fdecea;
    color: #b3261e;
    padding: 0.7rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  label {
    display: block;
    text-align: left;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #666;
    margin-bottom: 1.2rem;
  }
  input {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    font-family: var(--font-body);
  }
  input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .login-card .btn {
    width: 100%;
    margin-top: 0.5rem;
    text-align: center;
  }
</style>
