---
// Decorative backdrop for the dark `.page-header` band, which is otherwise a
// flat block of colour.
//
// The motif is the trade itself rather than generic shapes: the diagonal
// ribbing of a twill weave (drill and gabardine are the fabrics most of the
// catalogue is cut from) with long dashed seam runs over it, like the stitching
// down a sleeve. Everything is drawn in the brand accent at low opacity so the
// title keeps its contrast, and the seams sit in the top and bottom bands,
// clear of the centred text.
//
// Two techniques on purpose. The weave is a CSS repeating gradient on the <svg>
// element itself, so it tiles identically at any header size instead of being
// sheared or cropped. The seams are drawn with `preserveAspectRatio="none"` so
// the composition always fills the band exactly — from a 375px phone to an
// ultra-wide desktop — with `non-scaling-stroke` keeping the line weight and
// the dash rhythm constant through that stretch.
//
// The element it sits in must be `position: relative` and clip its overflow.
---

<svg class="header-pattern" viewBox="0 0 1440 380" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="hp-glow" cx="50%" cy="104%" r="72%">
      <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.22" />
      <stop offset="60%" stop-color="var(--color-accent)" stop-opacity="0.06" />
      <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1440" height="380" fill="url(#hp-glow)" />

  <g fill="none" stroke="var(--color-accent)" stroke-linecap="round">
    <path d="M-60 74 C 300 12, 520 132, 862 62 S 1266 -14, 1500 34" stroke-width="2" stroke-dasharray="16 13" stroke-opacity="0.32" />
    <path d="M-60 112 C 320 54, 540 172, 880 104 S 1280 30, 1500 74" stroke-width="1.4" stroke-dasharray="7 11" stroke-opacity="0.17" />
    <path d="M-60 304 C 236 224, 424 344, 706 252 S 1186 130, 1500 212" stroke-width="2" stroke-dasharray="16 13" stroke-opacity="0.32" />
    <path d="M-60 344 C 256 272, 444 388, 726 300 S 1206 182, 1500 256" stroke-width="1.4" stroke-dasharray="7 11" stroke-opacity="0.17" />
  </g>
</svg>

<style>
  .header-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Twill ribbing. Literal rgba because a gradient colour stop can't take an
       alpha on top of a custom property; this is var(--color-accent) at 5.5%. */
    background-image: repeating-linear-gradient(
      45deg,
      rgba(234, 88, 35, 0.055) 0 2px,
      transparent 2px 11px
    );
  }

  .header-pattern path {
    vector-effect: non-scaling-stroke;
  }
</style>
