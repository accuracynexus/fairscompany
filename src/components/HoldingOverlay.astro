---
/**
 * Componente de Pantalla Fija de Bloqueo (Holding Page / Overlay de Mantenimiento / Pago Pendiente)
 * 
 * Muestra una portada a pantalla completa que cubre la página web con imágenes adaptativas:
 * - readypc.jpg en PC / Escritorio (pantallas >= 768px)
 * - readycel.jpg en Dispositivos Móviles
 * 
 * Para deshabilitar el bloqueo cuando reciban el pago final:
 * Simplemente cambie `isLocked = false` o comente `<HoldingOverlay />` en `src/layouts/Layout.astro`.
 */
interface Props {
  isLocked?: boolean;
}

const { isLocked = false } = Astro.props;
---

{isLocked && (
  <div class="holding-overlay" id="holding-overlay">
    <picture class="holding-picture">
      <!-- Imagen para pantallas de PC / laptop (pantallas >= 768px) -->
      <source media="(min-width: 768px)" srcset="/readypc.jpg" />
      <!-- Imagen para dispositivos móviles (pantallas < 768px) -->
      <img src="/readycel.jpg" alt="Portada Fair's Company" class="holding-img" />
    </picture>
  </div>
)}

<style>
  .holding-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 99999999;
    background-color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .holding-picture {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .holding-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>

{isLocked && (
  <style is:global>
    html, body {
      overflow: hidden !important;
      height: 100% !important;
      max-height: 100vh !important;
      touch-action: none !important;
    }
  </style>
)}
