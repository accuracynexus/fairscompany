---
import { getImage, Image } from 'astro:assets';
import splashLogo from '../img/logo/logo-splash.png';
import splashBg from '../img/logo/fondo-splash.png';

const bg = await getImage({ src: splashBg, width: 1920, format: 'webp', quality: 80 });
---

<div id="splash-screen" class="splash" role="status" aria-live="polite" aria-label="Cargando" style={`background-image: url('${bg.src}')`}>
  <div class="splash-inner">
    <div class="splash-logo">
      <Image src={splashLogo} width={1765} height={1170} alt="Fair's Company" loading="eager" />
    </div>

    <div class="splash-bar" aria-hidden="true">
      <span class="splash-bar-fill"></span>
    </div>

    <p class="splash-text">Cargando experiencia</p>
  </div>
</div>

<script>
  const splash = document.getElementById('splash-screen');

  if (splash) {
    // Keep the splash up long enough to read, but never let it trap the user
    // if `load` is slow (or never fires because an asset hangs).
    const MIN_VISIBLE_MS = 700;
    const MAX_WAIT_MS = 4000;
    const startedAt = performance.now();
    let dismissed = false;

    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    function hide() {
      if (dismissed) return;
      dismissed = true;

      splash.classList.add('is-complete');

      // Let the bar visibly reach 100% before fading the overlay away.
      setTimeout(() => {
        splash.classList.add('is-hidden');
        document.body.style.overflow = previousOverflow;
        setTimeout(() => splash.remove(), 600);
      }, 260);
    }

    function scheduleHide() {
      const elapsed = performance.now() - startedAt;
      setTimeout(hide, Math.max(0, MIN_VISIBLE_MS - elapsed));
    }

    if (document.readyState === 'complete') {
      scheduleHide();
    } else {
      window.addEventListener('load', scheduleHide, { once: true });
    }

    // Safety net: dismiss regardless of asset loading.
    setTimeout(hide, MAX_WAIT_MS);
  }
</script>

<noscript>
  <style>
    #splash-screen { display: none !important; }
  </style>
</noscript>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #0a0a0a;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.55s ease, visibility 0.55s ease;
  }

  .splash.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
  }

  .splash-logo {
    width: clamp(150px, 34vw, 210px);
    animation: splash-logo-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .splash-logo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  @keyframes splash-logo-in {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Loading bar */
  .splash-bar {
    position: relative;
    width: clamp(170px, 46vw, 230px);
    height: 3px;
    margin-top: 2.4rem;
    border-radius: 99px;
    background: rgba(234, 88, 35, 0.15);
    overflow: hidden;
    animation: splash-fade-in 0.6s ease 0.2s both;
  }

  .splash-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 99px;
    background: linear-gradient(90deg, #f0793f, var(--color-accent));
    box-shadow: 0 0 12px rgba(234, 88, 35, 0.45);
    animation: splash-progress 2.2s cubic-bezier(0.25, 0.8, 0.3, 1) forwards;
  }

  /* Sheen sweeping across the filled portion */
  .splash-bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.75),
      transparent
    );
    transform: translateX(-100%);
    animation: splash-sheen 1.4s ease-in-out infinite;
  }

  @keyframes splash-progress {
    0%   { width: 0; }
    55%  { width: 62%; }
    100% { width: 88%; }
  }

  @keyframes splash-sheen {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }

  /* Completion: snap to full, then the overlay fades out */
  .splash.is-complete .splash-bar-fill {
    animation: none;
    width: 100%;
    transition: width 0.25s ease-out;
  }
  .splash.is-complete .splash-bar-fill::after { animation: none; opacity: 0; }

  /* Caption */
  .splash-text {
    margin: 1.1rem 0 0;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #d8d8d8;
    animation: splash-fade-in 0.6s ease 0.35s both, splash-pulse 2s ease-in-out 1s infinite;
  }

  @keyframes splash-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes splash-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-logo,
    .splash-bar,
    .splash-text { animation: none; }
    .splash-bar-fill {
      animation: none;
      width: 88%;
    }
    .splash-bar-fill::after { animation: none; opacity: 0; }
  }
</style>
